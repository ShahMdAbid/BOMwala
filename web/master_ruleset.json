{
  "noise_patterns_to_strip": [
    "(?i)\\s*(?:for|compatible with|works with|support|fits|ideal for)\\s+(?:arduino|esp32|esp8266|raspberry\\s*pi|stm32|pic|avr|arm|robotics|nodemcu|mcu|smart\\s*car|diy|project)[\\w\\s]*",
    "(?i)\\s*[\\(\\[]?(?:china|original(?: chip)?|high quality|premium|genuine|imported|local chip|tested|refurbished|used|new|brand new|free delivery|made in [a-zA-Z\\s]+)[\\)\\]]?",
    "(?i)\\s*[\\(\\[]?(?:1\\s*pcs?|pack of \\d+|\\d+\\s*pcs?|\\d+\\s*pieces?|pair|set of \\d+|combo)[\\)\\]]?",
    "(?i)[\\-\\|/,]\\s*(?:best price in bangladesh|robotics bangladesh|electronicsbd|techshopbd|bdtronics).*",
    "(?i)\\s*\\(?(?:limited quantity|hq|standard quality|average quality)\\)?"
  ],
  "high_priority_override_rules": [
    {
      "override_component_type": "accessory_expansion",
      "trigger_patterns": [
        "(?i)\\b(?:expansion\\s*board|breakout\\s*board|shield|adapter|programmer|debugger|downloader|emulator|hat|base\\s*board|antenna|flasher|burning\\s*fixture|converter)\\b"
      ],
      "exclude_patterns": [
        "(?i)\\b(?:cnc\\s*shield|ramps)\\b"
      ]
    },
    {
      "override_component_type": "hardware_enclosure",
      "trigger_patterns": [
        "(?i)\\b(?:case|enclosure|shell|box|chassis|bracket|mount|acrylic|spacer|standoff|screw|nut|heat\\s*sink|cooling\\s*fan|holder|heatsink|bearing|pulley|washer|bumper|cover|wheel|disc|strip|nickel)\\b"
      ],
      "exclude_patterns": [
        "(?i)(?:with|w/)\\s+(?:case|cooling|fan|heatsink|holder|wheel|antenna)"
      ]
    },
    {
      "override_component_type": "wiring_connector",
      "trigger_patterns": [
        "(?i)\\b(?:jumper\\s*wire|dupont|cable|connector|pin\\s*header|terminal\\s*block|socket|jack|plug|pigtail|awg|zip\\s*tie|clip)\\b",
        "(?i)\\b(?:test\\s*lead|multimeter\\s*probe|test\\s*probe)\\b"
      ],
      "exclude_patterns": [
        "(?i)(?:with|w/)\\s+(?:cable|wire|usb|connector)"
      ]
    },
    {
      "override_component_type": "passive_component",
      "trigger_patterns": [
        "(?i)\\b(?:resistor|capacitor|diode|transistor|inductor|potentiometer|mosfet|triac|led|trimpot|thermistor)\\b"
      ],
      "exclude_patterns": [
        "(?i)\\b(?:module|board|shield|tester|meter)\\b"
      ]
    }
  ],
